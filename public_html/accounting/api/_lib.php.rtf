declare(strict_types=1);\
header('Content-Type: application/json; charset=utf-8');\
date_default_timezone_set('Asia/Taipei');\
\
function cfg(): array \{\
  static $c;\
  if (!$c) $c = include __DIR__ . '/config.php';\
  return $c;\
\}\
\
function pdo(): PDO \{\
  $c = cfg();\
  $dsn = sprintf(\
    'mysql:host=%s;port=%s;dbname=%s;charset=%s',\
    $c['db_host'], $c['db_port'], $c['db_name'], $c['charset']\
  );\
  $pdo = new PDO($dsn, $c['db_user'], $c['db_pass'], [\
    PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,\
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,\
  ]);\
  $pdo->query("SET NAMES \{$c['charset']\}");\
  return $pdo;\
\}\
\
function ok(array $data = []): void \{\
  echo json_encode(['ok' => true, 'ts' => date('c')] + $data, JSON_UNESCAPED_UNICODE);\
\}\
\
function fail(string $msg, int $code = 200): void \{\
  http_response_code($code);\
  echo json_encode(['ok' => false, 'error' => $msg, 'ts' => date('c')], JSON_UNESCAPED_UNICODE);\
\}\
}